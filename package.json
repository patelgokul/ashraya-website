{
  "name": "ashraya-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare upload",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:games": "tsx prisma/seed-game-day.ts",
    "db:update:games": "tsx prisma/update-game-day-content.ts",
    "test:games": "tsx --test lib/game-rules.test.ts prisma/game-day.integration.test.ts",
    "test:games:db": "GAME_DB_TESTS=1 tsx --test prisma/game-day.integration.test.ts",
    "test:games:browser": "playwright test",
    "test:games:load": "tsx scripts/game-day-load.ts",
    "game:assets": "tsx scripts/game-day-assets.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@hookform/resolvers": "^3.3.4",
    "@lottiefiles/dotlottie-react": "^0.21.0",
    "@neondatabase/serverless": "^0.10.4",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fastest-levenshtein": "^1.0.16",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.400.0",
    "next": "^14.2.5",
    "next-auth": "^4.24.7",
    "nodemailer": "^6.9.14",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "postcss": "^8.4.39",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "wrangler": "^4.152.0"
  }
}
