generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ADMIN)
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  donations CampaignDonation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// ─── CAMPAIGNS ───────────────────────────────────

model Campaign {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String           @db.Text
  story        String           @db.Text
  category     CampaignCategory
  status       CampaignStatus   @default(ACTIVE)
  goalAmount   Float
  raisedAmount Float            @default(0)
  donorCount   Int              @default(0)
  startDate    DateTime         @default(now())
  endDate      DateTime?
  isFeatured   Boolean          @default(false)
  isUrgent     Boolean          @default(false)
  isTrending   Boolean          @default(false)
  coverImage   String?
  gallery      String[]
  beneficiaries Int?
  metaTitle    String?
  metaDesc     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  donations CampaignDonation[]
  updates   CampaignUpdate[]
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  content    String   @db.Text
  images     String[]
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignDonation {
  id            String        @id @default(cuid())
  campaignId    String
  userId        String?
  donorName     String
  donorEmail    String
  donorPhone    String?
  amount        Float
  currency      String        @default("INR")
  message       String?
  isAnonymous   Boolean       @default(false)
  paymentMethod PaymentMethod @default(RAZORPAY)
  paymentId     String?       @unique
  orderId       String?
  status        PaymentStatus @default(PENDING)
  receiptSent   Boolean       @default(false)
  createdAt     DateTime      @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([donorEmail])
  @@index([status])
}

enum CampaignCategory {
  EDUCATION
  WOMEN_EMPOWERMENT
  HEALTHCARE
  ENVIRONMENT
  EMERGENCY_RELIEF
  CHILD_WELFARE
  LIVELIHOOD
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  RAZORPAY
  OFFLINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ─── PROJECTS ────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String        @db.Text
  category      String
  status        ProjectStatus @default(ONGOING)
  budget        Float?
  spent         Float         @default(0)
  beneficiaries Int?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  coverImage    String?
  gallery       String[]
  isFeatured    Boolean       @default(false)
  impactMetrics Json?
  metaTitle     String?
  metaDesc      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
  ON_HOLD
}

// ─── VOLUNTEERS ──────────────────────────────────

model Volunteer {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String
  city         String
  state        String?
  skills       String[]
  interests    String[]
  availability VolunteerAvail  @default(FLEXIBLE)
  status       VolunteerStatus @default(PENDING)
  notes        String?
  joinedAt     DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum VolunteerAvail {
  WEEKDAYS
  WEEKENDS
  BOTH
  FLEXIBLE
}

enum VolunteerStatus {
  PENDING
  APPROVED
  ACTIVE
  INACTIVE
}

// ─── SUBSCRIBERS ─────────────────────────────────

model Subscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  status       SubscriberStatus @default(ACTIVE)
  source       String?
  subscribedAt DateTime         @default(now())
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

// ─── CONTACT MESSAGES ────────────────────────────

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  repliedAt DateTime?
  createdAt DateTime      @default(now())
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// ─── IMPACT ──────────────────────────────────────

model ImpactMetric {
  id         String   @id @default(cuid())
  label      String
  value      Float
  unit       String?
  icon       String?
  category   String
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── FUND PREDICTIONS ────────────────────────────

model FundPrediction {
  id                  String   @id @default(cuid())
  activeDonors        Int
  avgDonation         Float
  campaignCount       Int
  socialReach         Int
  volunteerCount      Int
  eventParticipation  Int
  prevYearFunding     Float
  monthlyVisitors     Int
  emailSubscribers    Int
  predictedMonthly    Float
  predictedAnnual     Float
  growthRate          Float
  fundingHealthScore  Float
  sustainabilityScore Float
  riskLevel           String
  actualMonthly       Float?
  modelVersion        String   @default("v1.0-heuristic")
  createdAt           DateTime @default(now())
}

// ─── GAME DAY ────────────────────────────────────

model GameEvent {
  id        String      @id @default(cuid())
  title     String
  company   String
  location  String
  eventDate DateTime    @db.Date
  games     String[]
  givingUrl String?
  createdAt DateTime    @default(now())
  scores    GameScore[]
  teamsLockedAt DateTime?
  huntDeadlineAt DateTime?
  verificationFormUrl String?
  rounds GameRound[]
  teams Team[]
  registrations GameRegistration[]

  @@index([eventDate])
}

/// alias is stored lowercase and is the login: entering it again on any device signs that player in.
model GameParticipant {
  alias     String      @id
  name      String
  phone     String?
  isAdmin   Boolean @default(false)
  createdAt DateTime    @default(now())
  scores    GameScore[]
  registrations GameRegistration[]
  memberships TeamMember[]
}

model GameScore {
  id          String          @id @default(cuid())
  alias       String
  eventId     String
  game        String
  points      Int
  roundId     String?
  questionId  String?
  teamId      String?
  source      ScoreSource @default(AUTO)
  reason      String?
  createdBy   String?
  voidedAt    DateTime?
  createdAt   DateTime        @default(now())
  participant GameParticipant @relation(fields: [alias], references: [alias])
  event       GameEvent       @relation(fields: [eventId], references: [id])
  refundForId String?
  refundFor GameScore? @relation("HintRefund", fields: [refundForId], references: [id], onDelete: Cascade)
  refunds GameScore[] @relation("HintRefund")

  @@index([alias])
  @@index([refundForId])
  @@index([eventId, createdAt])
  @@index([createdAt])
  @@unique([questionId, alias])
  @@unique([roundId, teamId])
}

enum RoundKind {
  SONG
  RIDDLE
  HUNT_LEVEL
  SCRIBBLE
  VERIFY
  VOLUNTEER
}

enum ScoreSource {
  AUTO
  ADMIN
}

enum VerificationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model GameRegistration {
  eventId String
  alias String
  joinedAt DateTime @default(now())
  event GameEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant GameParticipant @relation(fields: [alias], references: [alias], onDelete: Cascade, onUpdate: Cascade)
  @@id([eventId, alias])
}

model Team {
  id String @id @default(cuid())
  eventId String
  name String
  captainAlias String
  finishedAt DateTime?
  finishPlace Int?
  createdAt DateTime @default(now())
  event GameEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members TeamMember[]
  progress TeamLevelProgress[]
  @@unique([eventId, name])
}

model TeamMember {
  eventId String
  alias String
  teamId String
  slot Int
  joinedAt DateTime @default(now())
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant GameParticipant @relation(fields: [alias], references: [alias], onDelete: Cascade, onUpdate: Cascade)
  @@id([eventId, alias])
  @@unique([teamId, slot])
}

model GameRound {
  id String @id @default(cuid())
  eventId String
  order Int
  kind RoundKind
  title String
  description String?
  maxPoints Int @default(1000)
  graceSec Int @default(3)
  halfLifeSec Int @default(20)
  floorPct Int @default(30)
  durationSec Int?
  maxAttempts Int?
  openedAt DateTime?
  closedAt DateTime?
  requiresVerification Boolean @default(false)
  isFinal Boolean @default(false)
  event GameEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions GameQuestion[]
  progress TeamLevelProgress[]
  @@unique([eventId, order])
}

model GameQuestion {
  id String @id @default(cuid())
  roundId String
  order Int @default(0)
  prompt String?
  mediaUrl String?
  acceptedAnswers String[]
  matchThreshold Float @default(0.85)
  maxPoints Int?
  hints Json @default("[]")
  revealOnSolve String?
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  attempts GameAttempt[]
  @@unique([roundId, order])
}

model GameAttempt {
  id String @id @default(cuid())
  questionId String
  alias String
  teamId String?
  answer String
  similarity Float
  isCorrect Boolean
  points Int @default(0)
  createdAt DateTime @default(now())
  question GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@index([questionId, alias])
  @@index([questionId, teamId])
  @@index([alias, createdAt])
  @@index([teamId, createdAt])
}

model TeamLevelProgress {
  teamId String
  roundId String
  unlockedAt DateTime
  solvedAt DateTime?
  highestHint Int @default(0)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  @@id([teamId, roundId])
}

model ScoreVerification {
  id String @id @default(cuid())
  eventId String
  alias String
  hours Decimal @db.Decimal(5, 2)
  screenshotKey String?
  note String?
  status VerificationStatus @default(SUBMITTED)
  rejectReason String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([eventId, alias])
}

model VolunteerPledge {
  id String @id @default(cuid())
  eventId String
  alias String
  name String
  email String?
  phone String?
  mode String
  city String?
  availability String
  hoursPerMonth String
  interests String[]
  other String?
  consent Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, alias])
}

model GameAudit {
  id String @id @default(cuid())
  eventId String?
  actor String
  action String
  detail Json
  createdAt DateTime @default(now())
  @@index([eventId, createdAt])
}

model GamePinAttempt {
  alias String @id
  failures Int @default(0)
  windowAt DateTime @default(now())
}
